{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kunzyyy/AI-automated-cutting/schemas/job.schema.json",
  "title": "Video Editing Job",
  "description": "A request accepted by the Video Worker and orchestrated by n8n.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "created_at",
    "status",
    "input",
    "brief",
    "delivery"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "job_id": {
      "$ref": "#/$defs/id"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Optional n8n execution or upstream business identifier."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "analyzing",
        "planning",
        "rendering",
        "reviewing",
        "finalizing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_videos"
      ],
      "properties": {
        "source_videos": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/media_asset"
          }
        },
        "reference_videos": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/media_asset"
          }
        },
        "end_card": {
          "$ref": "#/$defs/media_asset",
          "description": "Optional brand end card appended after the body; omit to deliver the body only."
        },
        "bgm_library_uri": {
          "type": "string",
          "format": "uri-reference",
          "description": "Optional instrumental music library: mounted directory or single audio file; omit for a silent body."
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_name",
        "category",
        "objective",
        "language",
        "candidate_count",
        "target_body_duration_seconds",
        "max_recut_attempts",
        "requirements"
      ],
      "properties": {
        "product_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "audience": {
          "type": "string",
          "maxLength": 500
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "description": "Number of independent final candidates requested."
        },
        "target_body_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "max_recut_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "description": "Maximum Reviewer-triggered rerenders after the initial rough cut."
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "narrative_template": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semantic_tag"
          }
        },
        "freeform_notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_uri",
        "container",
        "width",
        "height",
        "fps",
        "human_approval"
      ],
      "properties": {
        "output_uri": {
          "type": "string",
          "format": "uri-reference"
        },
        "container": {
          "type": "string",
          "enum": [
            "mp4"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 360
        },
        "height": {
          "type": "integer",
          "minimum": 640
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "human_approval": {
          "type": "boolean"
        },
        "callback_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "media_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "uri"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/id"
        },
        "uri": {
          "type": "string",
          "format": "uri-reference"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "display_name": {
          "type": "string",
          "maxLength": 255
        }
      }
    },
    "semantic_tag": {
      "type": "string",
      "enum": [
        "unboxing",
        "product_macro",
        "multiple_variants",
        "photo_selection",
        "text_customization",
        "wearing_action",
        "wearing_result",
        "touching_memory",
        "gift_box",
        "daily_life",
        "emotional_close",
        "product_detail",
        "product_display",
        "usage_demo",
        "usage_result",
        "packaging"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
